# Self AI Environment Variables Template
# Copy this file to '.env' and fill in your actual Gemini API key.
# DO NOT commit '.env' containing real secrets to GitHub!

# Google Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini model
MODEL_NAME=gemini-3.6-flash

# Level 2 Voice Interface Settings
ENABLE_VOICE=true
VOICE_SPEED=180

# Groq Secondary Fallback Provider
# Set to 'auto' to let Self AI auto-detect the best available Groq model
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=auto
